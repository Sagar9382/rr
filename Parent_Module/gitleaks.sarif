{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "terraform-password-leak",
       "shortDescription": {
        "text": "Detected a possible password or secret in Terraform vars"
       }
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "terraform-password-leak has detected secret for file providers.tf."
     },
     "ruleId": "terraform-password-leak",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "providers.tf"
        },
        "region": {
         "startLine": 13,
         "startColumn": 10,
         "endLine": 13,
         "endColumn": 40,
         "snippet": {
          "text": "key"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "terraform-password-leak has detected secret for file terraform.tfvars."
     },
     "ruleId": "terraform-password-leak",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "terraform.tfvars"
        },
        "region": {
         "startLine": 82,
         "startColumn": 6,
         "endLine": 82,
         "endColumn": 35,
         "snippet": {
          "text": "password"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    }
   ]
  }
 ]
}
